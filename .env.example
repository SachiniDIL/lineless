
# ==========================================
# APPLICATION
# ==========================================

APP_ENV=development

# ==========================================
# POSTGRESQL
# ==========================================

POSTGRES_USER=lineless
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lineless

# Database names for individual services
AUTH_DB=auth_db
QUEUE_DB=queue_db

# ==========================================
# REDIS
# ==========================================

REDIS_PASSWORD=change_me

# ==========================================
# KAFKA
# ==========================================

KAFKA_CLUSTER_ID=replace_with_generated_cluster_id

# ==========================================
# JWT
# ==========================================

JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem

JWT_ISSUER=lineless-auth
JWT_AUDIENCE=lineless-api
JWT_ACCESS_TOKEN_EXPIRATION=900

# ==========================================
# GOOGLE OAUTH 2.0
# ==========================================

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# EMAIL
# ==========================================

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=change_me
MAIL_FROM=noreply@example.com

# ==========================================
# FRONTEND
# ==========================================

NEXT_PUBLIC_API_URL=http://localhost:8080

# ==========================================
# PRODUCTION
# ==========================================

DOMAIN=example.com